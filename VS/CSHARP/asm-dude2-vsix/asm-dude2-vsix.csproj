<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ExtensionName>AsmDude2</ExtensionName>
    <ExtensionVersion>1.0.0.0</ExtensionVersion>
    <NoWarn>VSEXTPREVIEW_LSP;VSEXTPREVIEW_SETTINGS;VSEXTPREVIEW_CODELENS;VSEXTPREVIEW_TAGGERS</NoWarn>
    <ExtensionDeploymentRootSuffix>Exp</ExtensionDeploymentRootSuffix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="18.5.39115-Preview" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="18.5.39115-Preview" PrivateAssets="all" />
    <!-- VSSDK.BuildTools comes transitively from Extensibility.Build -->
    <!-- Pin to fix CVEs in transitive Nerdbank.MessagePack 1.0.11 from Extensibility SDK's StreamJsonRpc 2.25.6 -->
    <PackageReference Include="Nerdbank.MessagePack" Version="1.2.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dependency-light shared settings contract (AsmSettingsData + ColorJsonConverter). Lets the
         VSIX serialize the SAME type the server deserializes, so settings.json is compile-checked.
         Deliberately NOT a reference to asm-tools-lib (which would drag Roslyn into the extension). -->
    <ProjectReference Include="..\asm-options-lib\asm-options-lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The server's resources (AsmDudeData.xml, signature-*.txt, Performance\*.tsv) are bundled from the
         LSP server build output below (the Server\** glob), NOT duplicated here. -->
    <None Update="AsmDude2.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInExtension>true</IncludeInExtension>
    </None>
  </ItemGroup>

  <!-- TextMate grammar: required for VS to render LSP semantic tokens -->
  <ItemGroup>
    <Content Include="Grammars\asm.tmLanguage.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Grammars.pkgdef">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <!-- Include the LSP server (and its Resources\, which carry the declared signature/perf data) in the
       VSIX. The server build output already contains exactly the runtime resources, so a second glob over
       the lib's Resources folder is intentionally NOT used — it would also drag in non-runtime artifacts
       (overview.txt, retired signature-may2019.txt). -->
  <ItemGroup>
    <Content Include="..\asm-dude2-ls\bin\$(Configuration)\net10.0-windows\**\*.*">
      <Link>Server\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
