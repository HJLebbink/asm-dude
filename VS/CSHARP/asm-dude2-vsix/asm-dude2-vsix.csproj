<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Suppress preview feature warnings for LSP -->
    <NoWarn>$(NoWarn);VSEXTPREVIEW_LSP;NETSDK1137;MSB9008;VSEXT0010</NoWarn>

    <!-- Specify .NET versions this extension targets -->
    <DotnetTargetVersions>10.0</DotnetTargetVersions>

    <!-- Extension metadata -->
    <ExtensionName>AsmDude2</ExtensionName>
    <ExtensionDisplayName>AsmDude2</ExtensionDisplayName>
    <ExtensionDescription>Syntax highlighting and code assistance for assembly source code (.asm, .cod, .inc, .s) and the Disassembly Window</ExtensionDescription>
    <ExtensionVersion>1.0.0.0</ExtensionVersion>
    <ExtensionPublisher>Henk-Jan Lebbink</ExtensionPublisher>

    <!-- Build settings -->
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <Title>AsmDude2 - Assembly Language Extension for Visual Studio</Title>
    <Version>1.0.0.0</Version>
    <Authors>Henk-Jan Lebbink</Authors>
    <Description>Syntax highlighting and code assistance for assembly source code (.asm, .cod, .inc, .s) and the Disassembly Window</Description>
    <AssemblyName>AsmDude2</AssemblyName>
    <Company></Company>
    <RootNamespace>AsmDude2</RootNamespace>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</SourceRevisionId>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <LangVersion>14</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- VisualStudio.Extensibility auto-deployment settings -->
    <ExtensionDeploymentRootSuffix>Exp</ExtensionDeploymentRootSuffix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>7</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>7</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- VisualStudio.Extensibility SDK for LSP support -->
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Contracts" Version="17.14.2098" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference assembly tools library -->
    <ProjectReference Include="..\asm-tools-lib\asm-tools-lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!-- Bundle the LSP server with the extension -->
  <Target Name="BundleLspServer" AfterTargets="Build">
    <!-- Copy LSP server files to output -->
    <ItemGroup>
      <ServerFiles Include="..\asm-dude2-ls\bin\$(Configuration)\net10.0-windows\*.*" />
      <ServerResources Include="..\asm-dude2-ls\bin\$(Configuration)\net10.0-windows\Resources\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ServerFiles)" DestinationFolder="$(OutputPath)Server\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ServerResources)" DestinationFiles="@(ServerResources->'$(OutputPath)Server\Resources\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <!-- Package Server directory into VSIX using 7z -->
    <Exec Command="cd /d &quot;$(OutputPath)&quot; &amp;&amp; 7z a -tzip &quot;AsmDude2.vsix&quot; &quot;Server\*&quot;" ContinueOnError="true" />
  </Target>

  <!-- Fix extension.json to correct class references -->
  <Target Name="FixExtensionManifest" AfterTargets="BundleLspServer">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;fix-extension-manifest.ps1&quot; -VsixPath &quot;$(OutputPath)AsmDude2.vsix&quot;" />
  </Target>

  <!-- Deploy extension to experimental instance in Debug configuration -->
  <Target Name="DeployToExperimental" AfterTargets="FixExtensionManifest" Condition="'$(Configuration)' == 'Debug'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;deploy-to-experimental.ps1&quot; -VsixPath &quot;$(OutputPath)AsmDude2.vsix&quot;" />
  </Target>

</Project>
