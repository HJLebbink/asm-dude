<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>

    <!-- Suppress preview feature warnings for LSP -->
    <NoWarn>$(NoWarn);VSEXTPREVIEW_LSP</NoWarn>

    <!-- Extension metadata -->
    <ExtensionName>AsmDude2</ExtensionName>
    <ExtensionDisplayName>AsmDude2</ExtensionDisplayName>
    <ExtensionDescription>Syntax highlighting and code assistance for assembly source code (.asm, .cod, .inc, .s) and the Disassembly Window</ExtensionDescription>
    <ExtensionVersion>2.1.0.0</ExtensionVersion>
    <ExtensionPublisher>Henk-Jan Lebbink</ExtensionPublisher>

    <!-- Build settings -->
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- New VisualStudio.Extensibility SDK -->
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" />

    <!-- StreamJsonRpc - latest version -->
    <PackageReference Include="StreamJsonRpc" Version="2.22.23" />

    <!-- JSON handling -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- We cannot reference asm-tools-lib directly as it targets net7.0-windows -->
    <!-- For now, we'll implement a simple wrapper or copy needed types -->
    <!-- TODO: Update asm-tools-lib to multi-target net7.0-windows;net8.0 -->
  </ItemGroup>

  <ItemGroup>
    <!-- Extension resources -->
    <None Include="Resources\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\asm-dude2-vsix\AsmDude2.png" Link="AsmDude2.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\asm-dude2-vsix\LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Bundle the LSP server with the extension -->
  <Target Name="IncludeLanguageServer" BeforeTargets="GetExtensionContentItems">
    <ItemGroup>
      <Content Include="$(MSBuildProjectDirectory)\..\asm-dude2-ls\bin\$(Configuration)\net7.0-windows\**\*.*">
        <Link>Server\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <IncludeInExtension>true</IncludeInExtension>
      </Content>
    </ItemGroup>
  </Target>

</Project>
