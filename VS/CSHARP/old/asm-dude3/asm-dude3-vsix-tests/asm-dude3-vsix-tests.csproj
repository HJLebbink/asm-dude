<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<RootNamespace>AsmDude3.Tests</RootNamespace>
		<AssemblyName>asm-dude3-vsix-tests</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<!-- xUnit Testing Framework -->
	<ItemGroup>
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<!-- Test SDK -->
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />

		<!-- Code coverage -->
		<PackageReference Include="coverlet.collector" Version="6.0.4">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<!-- Fluent assertions for readable tests -->
		<PackageReference Include="FluentAssertions" Version="7.0.0" />

		<!-- Extended WPF Toolkit for ColorPicker -->
		<PackageReference Include="Extended.Wpf.Toolkit" Version="4.6.1" />
	</ItemGroup>

	<!-- Reference to the VSIX project -->
	<ItemGroup>
		<ProjectReference Include="..\asm-dude3-vsix\asm-dude3-vsix.csproj" />
	</ItemGroup>

</Project>
