<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.props" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <SignAssembly>false</SignAssembly>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CA1001,CA1305,CA1307,CA1721,CA1724,CA1801,CA1822,CA2007,CA2213,CS1591,CS1668</NoWarn>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
    <WarningLevel>7</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
    <WarningLevel>7</WarningLevel>
  </PropertyGroup>
  <PropertyGroup>
    <SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</SourceRevisionId>
    <Authors>Henk-Jan Lebbink</Authors>
    <Company>SnellerInc</Company>
    <Product>AsmDude2.LSP.Lib</Product>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="asm-dude2-ls-tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Resourses\**" />
    <EmbeddedResource Remove="Resourses\**" />
    <None Remove="Resourses\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Resources\AsmDudeData.xml" />
    <None Remove="Resources\Performance\Broadwell.tsv" />
    <None Remove="Resources\Performance\Haswell.tsv" />
    <None Remove="Resources\Performance\Instructions-Translations.tsv" />
    <None Remove="Resources\Performance\IvyBridge.tsv" />
    <None Remove="Resources\Performance\Skylake.tsv" />
    <None Remove="Resources\Performance\SkylakeX.tsv" />
    <None Remove="Resources\signature-hand-1.txt" />
    <None Remove="Resources\signature-may2019.txt" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\AsmDudeData.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Performance\Broadwell.tsv">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Performance\Haswell.tsv">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Performance\Instructions-Translations.tsv">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Performance\IvyBridge.tsv">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Performance\Skylake.tsv">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Performance\SkylakeX.tsv">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\signature-hand-1.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\signature-may2019.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!--
    ============================================================================
    IMPORTANT: IgnoresAccessChecksToGenerator CLR Hack
    ============================================================================
    This project uses IgnoresAccessChecksToGenerator to access INTERNAL types
    from Microsoft.CodeAnalysis.LanguageServer.Protocol (Roslyn LSP).

    WHY: Roslyn's LSP types (Position, Range, Hover, VSInternalHover, etc.) are
    marked as 'internal' and not publicly accessible. However, we need these
    types for proper Visual Studio LSP integration, especially for features like:
    - VSInternalHover with clickable hyperlinks (RawContent)
    - ClassifiedTextElement/ClassifiedTextRun for styled text
    - Other VS-specific LSP extensions

    HOW: The IgnoresAccessChecksToAttribute is a secret CLR attribute (recognized
    by .NET Framework 4.6+ and .NET Core) that bypasses visibility checks. The
    IgnoresAccessChecksToGenerator package generates reference assemblies where
    internal types become public, allowing compilation against them.

    RISKS:
    - Internal APIs may change without notice in future Roslyn versions
    - This is an unsupported usage pattern
    - May break on Roslyn updates - version lock recommended

    References:
    - https://github.com/aelij/IgnoresAccessChecksToGenerator
    - https://www.strathweb.com/2018/10/no-internalvisibleto-no-problem-bypassing-c-visibility-rules-with-roslyn/
    - https://github.com/dotnet/roslyn/issues/68696 (Roslyn LSP public API tracking)
    ============================================================================
  -->

  <!-- Configure IgnoresAccessChecksTo for Roslyn LSP internal types -->
  <ItemGroup>
    <IgnoresAccessChecksTo Include="Microsoft.CodeAnalysis.LanguageServer.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.VisualStudio.Language.StandardClassification" Version="17.14.249" />

    <!-- Roslyn LSP types (internal, accessed via IgnoresAccessChecksToGenerator) -->
    <PackageReference Include="Microsoft.CodeAnalysis.LanguageServer.Protocol" Version="5.6.0-2.26125.2" />

    <!-- CLR hack to access internal types - generates public reference assemblies -->
    <PackageReference Include="IgnoresAccessChecksToGenerator" Version="0.8.0" PrivateAssets="All" />

	<PackageReference Include="StreamJsonRpc" Version="2.25.6" />
    <!-- Newtonsoft.Json removed - using System.Text.Json via SystemTextJsonFormatter -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\asm-tools-lib\asm-tools-lib.csproj" />
  </ItemGroup>

  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" />
</Project>