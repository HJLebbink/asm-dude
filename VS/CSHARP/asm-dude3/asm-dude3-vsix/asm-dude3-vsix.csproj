<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<Import Sdk="Microsoft.NET.Sdk" Project="Sdk.props" />

	<PropertyGroup>
		<Title>AsmDude3</Title>
		<Version>3.0.0.0</Version>
		<Authors>Henk-Jan Lebbink</Authors>
		<Product>AsmDude3</Product>
		<Description>Modern assembly language extension using Client 17.14.60 - Syntax highlighting and code assistance for assembly source code (.asm, .cod, .inc, .s)</Description>
		<Copyright>LICENSE.txt</Copyright>
		<PackageProjectUrl>https://github.com/HJLebbink/asm-dude</PackageProjectUrl>
		<StartAction>Program</StartAction>
		<StartProgram>$(DevenvDir)devenv.exe</StartProgram>
		<StartArguments>/rootSuffix Exp /log</StartArguments>
		<RootNamespace>AsmDude3</RootNamespace>
		<PlatformTarget>x64</PlatformTarget>
		<!-- ApplicationIcon removed because file is missing in the repository -->
		<IsPublishable>False</IsPublishable>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<GeneratePkgDefFile>true</GeneratePkgDefFile>
		<PackageId>AsmDude3</PackageId>
		<Company>Henk-Jan Lebbink</Company>
		<RepositoryType>git</RepositoryType>
		<PackageOutputPath>vsix\</PackageOutputPath>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<EnableNETAnalyzers>True</EnableNETAnalyzers>
		<!-- Use local license file included in the project -->
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageTags>ASM; AVX512; syntax highlighting; code completion; signature help; hover help</PackageTags>
		<RepositoryUrl>https://github.com/HJLebbink/asm-dude</RepositoryUrl>
		<PackageIcon>AsmDude3.png</PackageIcon>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Modern .NET Framework 4.8 (required by VSSDK) -->
		<TargetFramework>net48</TargetFramework>
		<OutputType>Library</OutputType>
		<UseCodebase>true</UseCodebase>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<NoWarn>CA1001,CA1052,CA1507,CA1812,CA2007,CS1591,NU1605,NU5100,VSTHRD100</NoWarn>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>

		<!-- VSIX configuration -->
		<!-- Disabled automatic pkgdef generation during regular builds to avoid CreatePkgDef errors -->
		<IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
		<IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
		<IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
		<CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
		<CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
		<VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug'">
		<DeployExtension>True</DeployExtension>
		<WarningLevel>9999</WarningLevel>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<WarningLevel>9999</WarningLevel>
	</PropertyGroup>

	<!-- Modern Package References - Client 17.14.60 (Active, May 2025) -->
	<ItemGroup>
		<!-- The actively maintained LSP Client package -->
		<PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.14.60" />

		<!-- Latest VS SDK packages for VS 2022/2026 -->
		<PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" />
		<PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2120">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<!-- Modern async and threading support -->
		<PackageReference Include="Microsoft.VisualStudio.Threading" Version="17.14.15" />
		<PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<!-- Latest StreamJsonRpc for LSP communication -->
		<PackageReference Include="StreamJsonRpc" Version="2.23.32-alpha" />
	</ItemGroup>

	<!-- Project References -->
	<ItemGroup>
		<ProjectReference Include="..\..\asm-tools-lib-net48\asm-tools-lib-net48.csproj" />
	</ItemGroup>

	<!-- Content and Resources -->
	<ItemGroup>
		<None Include="source.extension.vsixmanifest">
			<Generator>VsixManifestGenerator</Generator>
		</None>
		<!-- Include license in VSIX output root -->
		<Content Include="LICENSE.txt" Visible="false">
			<IncludeInVSIX>true</IncludeInVSIX>
			<VsixSubPath>\</VsixSubPath>
		</Content>
		<!-- Include resources needed by AsmDude2Tools -->
		<Content Include="Resources\AsmDudeData.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="Resources\signature-hand-1.txt">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="Resources\signature-may2019.txt">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
	</ItemGroup>

	<!-- Target to include LSP server in VSIX -->
	<Target Name="IncludeLanguageServer" BeforeTargets="GetVsixSourceItems" DependsOnTargets="ResolveProjectReferences">
		<ItemGroup>
			<!-- Use MSBuildProjectDirectory for reliable path resolution -->
			<Content Include="$(MSBuildProjectDirectory)\..\asm-dude3-server\bin\$(Configuration)\net10.0-windows\**\*.*" Visible="false">
				<IncludeInVSIX>true</IncludeInVSIX>
				<VsixSubPath>Server</VsixSubPath>
				<Link>Server\%(RecursiveDir)%(Filename)%(Extension)</Link>
			</Content>
		</ItemGroup>
	</Target>

	<Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" />
	<Import Project="$(VSToolsPath)\vssdk\Microsoft.VSSDK.targets" Condition="'$(VSToolsPath)' != ''" />

</Project>
