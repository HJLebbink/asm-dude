<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Title>AsmDude3 Language Server (LSP)</Title>
		<Version>3.0.0.0</Version>
		<Authors>Henk-Jan Lebbink</Authors>
		<Description>Modern LSP server for assembly language - supports LSP 3.17+ protocol</Description>
		<Company>Henk-Jan Lebbink</Company>
		<Product>AsmDude3.LSP</Product>

		<!-- Modern .NET 10 LTS -->
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>Exe</OutputType>
		<PlatformTarget>x64</PlatformTarget>

		<!-- C# 14 features enabled -->
		<LangVersion>14</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>false</AllowUnsafeBlocks>

		<!-- Code quality -->
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest</AnalysisLevel>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<WarningLevel>9999</WarningLevel>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Build metadata -->
		<SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</SourceRevisionId>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/HJLebbink/asm-dude</RepositoryUrl>
	</PropertyGroup>

	<!-- Modern LSP and JSON-RPC packages -->
	<ItemGroup>
		<!-- Latest StreamJsonRpc for LSP communication -->
		<PackageReference Include="StreamJsonRpc" Version="2.23.32-alpha" />

		<!-- Newtonsoft.Json for serialization -->
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

		<!-- Modern logging -->
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />

		<!-- Visual Studio LSP types for VSInternalHover and ClassifiedTextElement -->
		<PackageReference Include="Microsoft.VisualStudio.LanguageServer.Protocol" Version="17.2.8" />
		<PackageReference Include="Microsoft.VisualStudio.Language.StandardClassification" Version="17.14.249" />

		<!-- Symbolic execution with Z3 -->
		<PackageReference Include="Microsoft.Z3" Version="4.12.2" />
		<PackageReference Include="QuikGraph" Version="2.5.0" />
	</ItemGroup>

	<!-- Embedded resources -->
	<ItemGroup>
		<EmbeddedResource Include="Resources\AsmDudeData.xml" />
		<EmbeddedResource Include="Resources\signature-may2019.txt" />
		<EmbeddedResource Include="Resources\signature-hand-1.txt" />
		<EmbeddedResource Include="Resources\Performance\*.tsv" />
	</ItemGroup>

	<!-- Project references -->
	<ItemGroup>
		<!-- Assembly language tools library -->
		<ProjectReference Include="..\..\asm-tools-lib\asm-tools-lib.csproj" />

		<!-- Symbolic execution engine -->
		<ProjectReference Include="..\..\asm-sim-lib\asm-sim-lib.csproj" />
	</ItemGroup>

</Project>
